{
  "name": "@versatiles/release-tool",
  "version": "2.23.0",
  "description": "VersaTiles release and documentation tools",
  "bin": {
    "vrt": "./dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "npm run build:node && npm run doc",
    "prepare": "husky",
    "build:node": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/index.js",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test && npm run format:check",
    "dev": "tsx src/index.ts",
    "doc": "npm run doc:command && npm run doc:graph",
    "doc:command": "tsx src/index.ts doc-command vrt | tsx src/index.ts doc-insert README.md '# Command'",
    "doc:graph": "tsx src/index.ts deps-graph --svg assets/dependency-graph.svg | tsx src/index.ts doc-insert README.md '## Dependency Graph'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --color",
    "prepack": "npm run build",
    "release": "tsx src/index.ts release",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest --run --coverage",
    "test": "vitest --run",
    "upgrade": "tsx src/index.ts deps-upgrade"
  },
  "author": "Michael Kreil <versatiles@michael-kreil.de>",
  "license": "Unlicense",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/versatiles-org"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/versatiles"
    }
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/versatiles-org/node-release-tool.git"
  },
  "homepage": "https://github.com/versatiles-org/node-release-tool",
  "overrides": {
    "minimatch": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@schemastore/package": "^1.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mdast-util-to-markdown": "^2.2.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@inquirer/select": "^5.2.8",
    "commander": "^15.1.0",
    "dependency-cruiser": "^18.7.2",
    "elkjs": "^0.12.1",
    "npm-check-updates": "^23.1.1",
    "picomatch": "^4.0.7",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "semver": "^7.8.6",
    "typedoc": "^0.28.20",
    "typedoc-github-theme": "^0.4.0",
    "typedoc-github-wiki-theme": "^2.1.1",
    "typedoc-plugin-markdown": "^4.14.1"
  },
  "lint-staged": {
    "*.{ts,js,json,md,yml,yaml}": "prettier --write",
    "*.ts": "eslint --fix"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}